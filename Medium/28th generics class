import java.util.Arrays;

class GenericSorter<T extends Comparable<T>> {
    private T[] array;

    public GenericSorter(T[] array) {
        this.array = array;
    }

    // Method to sort the array
    public void sort() {
        Arrays.sort(array);
    }

    // Method to display the sorted array
    public void display() {
        System.out.println("Sorted array: " + Arrays.toString(array));
    }
}

public class Main {
    public static void main(String[] args) {
        // Sorting integers
        Integer[] intArray = {5, 2, 9, 1, 5, 6};
        GenericSorter<Integer> intSorter = new GenericSorter<>(intArray);
        intSorter.sort();
        intSorter.display();

        // Sorting strings
        String[] strArray = {"Banana", "Apple", "Orange", "Mango"};
        GenericSorter<String> strSorter = new GenericSorter<>(strArray);
        strSorter.sort();
        strSorter.display();

        // Sorting doubles
        Double[] doubleArray = {3.14, 2.71, 1.41, 1.73};
        GenericSorter<Double> doubleSorter = new GenericSorter<>(doubleArray);
        doubleSorter.sort();
        doubleSorter.display();
    }
}
