import java.util.Scanner;

// Class implementing Runnable interface to check for prime
class PrimeChecker implements Runnable {
    private int number;

    // Constructor to set the number
    public PrimeChecker(int number) {
        this.number = number;
    }

    @Override
    public void run() {
        if (isPrime(number)) {
            System.out.println(number + " is Prime");
        } else {
            System.out.println(number + " is Not Prime");
        }
    }

    // Method to check if a number is prime
    private boolean isPrime(int num) {
        if (num <= 1) return false; // Numbers less than or equal to 1 are not prime
        for (int i = 2; i <= Math.sqrt(num); i++) { // Check divisibility from 2 to sqrt(num)
            if (num % i == 0) {
                return false; // Not prime if divisible
            }
        }
        return true; // It's prime if no divisors found
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input a number from the user
        System.out.print("Enter a number: ");
        int number = sc.nextInt();

        // Create a thread to check for prime
        Thread primeThread = new Thread(new PrimeChecker(number));
        primeThread.start(); // Start the thread
    }
}
