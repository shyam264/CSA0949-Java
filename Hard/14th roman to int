import java.util.HashMap;

public class Solution {
    public int romanToInt(String s) {
        // Create a map for Roman numeral values
        HashMap<Character, Integer> romanMap = new HashMap<>();
        romanMap.put('I', 1);
        romanMap.put('V', 5);
        romanMap.put('X', 10);
        romanMap.put('L', 50);
        romanMap.put('C', 100);
        romanMap.put('D', 500);
        romanMap.put('M', 1000);
        
        int total = 0;  // Initialize result
        int prevValue = 0;  // Track the previous numeral's value
        
        // Iterate through the string from right to left
        for (int i = s.length() - 1; i >= 0; i--) {
            int currentValue = romanMap.get(s.charAt(i));
            
            // If current numeral is less than previous one, subtract it; otherwise, add it
            if (currentValue < prevValue) {
                total -= currentValue;
            } else {
                total += currentValue;
            }
            
            // Update prevValue to the current one
            prevValue = currentValue;
        }
        
        return total;
    }

    public static void main(String[] args) {
        Solution solution = new Solution();
        
        String roman1 = "III";   // Example input
        String roman2 = "IV";    // Example input
        String roman3 = "XXVII"; // Example input
        
        System.out.println(roman1 + " -> " + solution.romanToInt(roman1)); // Output: 3
        System.out.println(roman2 + " -> " + solution.romanToInt(roman2)); // Output: 4
        System.out.println(roman3 + " -> " + solution.romanToInt(roman3)); // Output: 27
    }
}
