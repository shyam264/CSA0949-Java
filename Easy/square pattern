public class SquareNumberPattern {

    public static void main(String[] args) {
        int n = 4; // Number of rows
        int number = 1; // Starting number

        // Loop through the rows
        for (int i = 1; i <= n; i++) {
            // Loop through columns for printing squares
            for (int j = 1; j <= i; j++) {
                System.out.print((number * number) + "\t");
                number++;
            }
            // Move to the next line after each row
            System.out.println();
        }
    }
}
