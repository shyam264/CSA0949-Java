import java.util.Scanner;

public class LCMGCDCalculator {

    // Method to compute GCD using the Euclidean algorithm
    public static int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    // Method to compute LCM using the GCD
    public static int lcm(int a, int b) {
        return (a * b) / gcd(a, b);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Read number of elements
        System.out.print("Enter the number of elements (N): ");
        int n = scanner.nextInt();

        // Read the first number
        System.out.print("Number 1: ");
        int lcm = scanner.nextInt(); // Initialize LCM with the first number
        int gcd = lcm; // Initialize GCD with the first number

        // Read remaining numbers and calculate LCM and GCD
        for (int i = 1; i < n; i++) {
            System.out.print("Number " + (i + 1) + ": ");
            int num = scanner.nextInt();
            lcm = lcm(lcm, num); // Calculate LCM
            gcd = gcd(gcd, num); // Calculate GCD
        }

        // Display results
        System.out.println("LCM = " + lcm);
        System.out.println("GCD = " + gcd);

        scanner.close();
    }
}
