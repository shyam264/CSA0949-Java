public class NumberPattern {

    public static void main(String[] args) {
        int n = 4; // Number of rows

        // Loop through the rows
        for (int i = 1; i <= n; i++) {
            // Loop through columns for printing numbers
            for (int j = 1; j <= i; j++) {
                System.out.print(i + " ");
            }
            // Move to the next line after each row
            System.out.println();
        }
    }
}
